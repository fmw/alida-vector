{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.clojure/data.json {:mvn/version "2.5.2"}

        integrant/integrant {:mvn/version "1.0.1"}
        metosin/malli {:mvn/version "0.20.1"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.brunobonacci/mulog {:mvn/version "0.10.1"}
        tick/tick {:mvn/version "1.0.1"}

        migratus/migratus {:mvn/version "1.6.6"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1108"}
        com.zaxxer/HikariCP {:mvn/version "7.0.2"}
        org.postgresql/postgresql {:mvn/version "42.7.11"}
        com.pgvector/pgvector {:mvn/version "0.1.6"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.17"}

        hato/hato {:mvn/version "1.0.0"}
        com.google.auth/google-auth-library-oauth2-http {:mvn/version "1.40.0"}
        org.jsoup/jsoup {:mvn/version "1.22.2"}
        com.github.pemistahl/lingua {:mvn/version "1.2.2"}
        etaoin/etaoin {:mvn/version "1.1.43"}
        org.clj-commons/claypoole {:mvn/version "1.2.2"}}

 :aliases
 {:run {:main-opts ["-m" "alida.main"]}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}
                      org.testcontainers/postgresql {:mvn/version "1.21.4"}}
         :main-opts ["-m" "kaocha.runner"]}

  :coverage {:extra-paths ["test"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
             :main-opts ["-m" "cloverage.coverage"
                         "-p" "src"
                         "-s" "test"
                         "--ns-regex" "^alida\\..*$"
                         "--test-ns-regex" "^alida\\.(?!integration\\.).*-test$"
                         "--text"
                         "--no-html"
                         "--no-colorize"
                         "--output" "target/coverage"]}

  :dev {:extra-paths ["dev" "test"]
        :extra-deps {integrant/repl {:mvn/version "0.4.0"}
                     nrepl/nrepl {:mvn/version "1.5.0"}
                     cider/cider-nrepl {:mvn/version "1.20.0"}
                     djblue/portal {:mvn/version "0.63.1"}}}

  :nrepl {:main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}}
          :ns-default build}}}
